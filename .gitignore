# Dependencies
node_modules/

# Build & test artifacts — all of these are regenerated by the npm scripts
# (`npm run harness`, `npm run verify:vault`, `npm run verify:view`), and the
# screenshots are non-deterministic, so they do not belong in version control.
harness/bundle.js
harness/official-filters.bundle.js
harness/graph.json
harness/shots/
scripts/verify-vault.cjs

# Editor / OS noise
.DS_Store
Thumbs.db
*.log

# Bundled on demand by `npm run eval:weights`.
scripts/weight-eval.cjs

# Same, for the eval scripts added with the insight work: each is built from its
# `scripts/*.ts` on every run, so a committed copy could only ever be a stale copy.
# (`scripts/stability-eval.cjs` is tracked — it predates this and is left alone.)
scripts/insight-eval.cjs
scripts/mention-ratings.cjs

# Built by `npm run build:ci`; the release workflow attaches it.
/main.js
